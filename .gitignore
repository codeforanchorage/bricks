# Secrets -- never commit
.env

# Python environment & caches
.venv/
__pycache__/
*.pyc

# Brick photos / video -- not committed (add your own to test_images/)
test_images/
test_bricks/
photos/
derivatives/
*.zip

# Deployed receiver copy with the real token (commit only the CHANGE-ME one)
web/receiver.local.php

# Ready-to-upload .htaccess variants (carry the real server paths)
web/htaccess_*.local

# Reviewer decision files (carry reviewer names; live data, not source)
decisions*.csv

# Tester feedback screenshots (contain names / private messages)
searching*.png
feedback*.png

# Generated output: CSVs, crops, annotated images
output/

# Scratch
frames/
_one/
*.prev
*.bak
test_strip.jpg

# Raw reference PDFs (re-downloadable from muni.org/Departments/parks --
# TownSquareBricks.aspx; the parsed CSVs are committed)
reference/*.pdf
*.pdf
